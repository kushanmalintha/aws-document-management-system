# Application
APP_NAME=AWS Document Management System
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
POSTGRES_DB=dms
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# JWT - generate a unique secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_secure_generated_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-free JSON array of explicit browser origins allowed by the API
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]

LOCAL_STORAGE_PATH=local_storage
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_DOCUMENT_EXTENSIONS=[".pdf",".txt",".doc",".docx",".xls",".xlsx",".ppt",".pptx",".csv",".png",".jpg",".jpeg"]
MAX_UPLOAD_FILENAME_LENGTH=255
